# Base URL of the Laravel application, as reachable **from the Next.js server**.
#
# This is a server-side value only — it is never exposed to the browser.
# The browser learns the public origin separately, from the signed submit URL
# that Laravel mints (Plan_UI.md Part II §9).
#
# Local dev:  http://127.0.0.1:8010
# Production: the public origin, e.g. https://fpiapr2.dictr2.cloud
LARAVEL_BASE_URL=http://127.0.0.1:8010
