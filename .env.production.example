# Production environment template — copy to .env and fill in.
# NEVER commit the filled file.

APP_NAME="FPIAP · FreeWiFi Monitor"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://your-domain.example

# Public self-registration stays off: provision accounts via users.manage.
REGISTRATION_ENABLED=false

# Probe-token lifetime in minutes (43200 = 30 days).
SANCTUM_EXPIRATION=43200

# Serve assets from a CDN or alternate host (leave unset to use APP_URL).
#ASSET_URL=https://cdn.your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freewifi_monitor
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Sessions + cache live in files on this single VPS — database for either
# is a MySQL round-trip per request (Plan.md backlog #7). The queue stays
# on database so workers keep visibility into retries.
CACHE_STORE=file
CACHE_PREFIX=freewifi_monitor

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# Weekly warranty digest recipient (optional).
WARRANTY_DIGEST_EMAIL=

# Monthly scheduled-report summary (optional — falls back to WATCHDOG_EMAIL).
REPORT_SCHEDULED_EMAIL=

# Telegram alerts (optional) — bot token from @BotFather + NOC group chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Error monitoring — leave SENTRY_ENABLED=false until the DSN exists.
SENTRY_ENABLED=false
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"

# Offsite backup destination (Plan_revision §Phase 2.6). Set to an S3-compatible
# disk name configured in config/filesystems.php to copy backups off the VPS.
BACKUP_OFFSITE_DISK=
BACKUP_ARCHIVE_PASSWORD=
